#!/usr/bin/env nextflow
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AVR-biosecurity-bioinformatics/freyr
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Github : https://github.com/AVR-biosecurity-bioinformatics/freyr
----------------------------------------------------------------------------------------
*/


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Global default params (typed)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/ 

params {

    help: Boolean                       = false
    outdir: String                      = "${launchDir}/output"

    ///// Input options
    samplesheet: String?                = null                              // location of samplesheet .csv; path
    primer_params: String?              = null                              // location of primer parameters .csv; path
    train_idtaxa: String?                = null                              // train IDTAXA model on ref_fasta database; 'formatted' or 'unformatted'

    extension: String?                  = null                              // extension of the .fastq read files, immediately after the digit indicating forward/reverse identity; string
    seq_type: String                    = "illumina"                        // data input is Illumina reads; string (illumina, nanopore, pacbio)
    paired: Boolean                     = true                              // Illumina data input is paired-end; boolean
    miseq_internal: Boolean              = false                             // data generated by an AgVic MiSeq machine; boolean
    miseq_dir: String?                   = null                              // directory containing MiSeq data, required when using '--miseq_internal'; path

    primer_error_rate: Float            = 1.0                               // error rate allowed when matching primers with cutadapt ('cutadapt -e'); number
    primer_n_trim: Boolean               = false                             // use '--match-read-wildcards' with cutadapt in PRIMER_TRIM to recognise N bases in reads

    /// TODO: replace this with equivalent input-file option
    high_sensitivity: Boolean            = true                              // enable dada2 high-sensitivity (pseudo-pooling) mode; boolean
    prior_min_samples: Integer           = 2                                 // minimum number of samples an ASV must be present in to be classified as a "prior" when --high_sensitivity; integer > 0
    dada_band_size: Integer              = 16                                // set BAND_SIZE parameter for dada2::dada function in 'denoise.R'; integer
    dada_homopolymer: Integer?           = null                              // set HOMOPOLYMER_GAP_PENALTY parameter for dada2::dada function in 'denoise.R'; integer < 0

    chimera_sample_frac: Float           = 0.9                               // minimum fraction of samples in which a sequence must be flagged as a chimera to be classified a chimera; see dada2::isBimeraDenovoTable(minSampleFraction); float (0-1)

    chunk_taxassign: Integer             = 100                               // number of sequences to be taxonomically assigned per process; integer > 0

    accumulation_curve: Boolean         = true                              // generate accumulation curves per sample for each primer pair; boolean

    merge_clusters: String?             = null                              // generate separate output files for filtered ASVs merged by cluster

    ///// primer_params override options
    pp_primers: String?                  = null
    pp_locus: String?                    = null
    pp_for_primer_seq: String?           = null
    pp_rev_primer_seq: String?           = null
    pp_max_primer_mismatch: String?      = null
    pp_read_min_length: String?          = null
    pp_read_max_length: String?          = null
    pp_read_max_ee: String?              = null
    pp_read_trunc_length: String?        = null
    pp_read_trim_left: String?           = null
    pp_read_trim_right: String?          = null
    pp_asv_min_length: String?           = null
    pp_asv_max_length: String?           = null
    pp_concat_unmerged: String?          = null
    pp_genetic_code: String?             = null
    pp_coding: String?                   = null
    pp_phmm: String?                     = null
    pp_idtaxa_db: String?                = null
    pp_ref_fasta: String?                = null
    pp_idtaxa_confidence: String?         = null
    pp_run_blast: String?                = null
    pp_blast_min_identity: String?       = null
    pp_blast_min_coverage: String?       = null
    pp_cluster_threshold: String?        = null
    pp_target_kingdom: String?           = null
    pp_target_phylum: String?            = null
    pp_target_class: String?             = null
    pp_target_order: String?             = null
    pp_target_family: String?            = null
    pp_target_genus: String?             = null
    pp_target_species: String?           = null
    pp_min_sample_reads: String?         = null
    pp_min_taxa_reads: String?           = null
    pp_min_taxa_ra: String?              = null

    ///// debugging options
    rdata: Boolean                      = false                             // save all data/objects from process-level R sessions as .RData files in work dir; boolean
    subsample: Integer?                 = null                              // reduce input samples (in ch_sample_locus_reads) to given number; integer
    downsample_reads: Integer?          = null                              // reduce input reads per sample to at most this many; integer
    debug_mode: Boolean                 = false                             // save intermediate process outputs for debugging

    slurm_account: String               = "default"                         // account to use on SLURM; default is for BASC only

    ///// Max resource options
    // Defaults only, expecting to be overwritten
    max_memory: String                  = '128.GB'
    max_cpus: Integer                   = 16
    max_time: String                    = '240.h'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Imports & Functions
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/ 

//// workflow import
include { FREYR  } from './nextflow/workflows/freyr'


// function imports
include {
    paramsHelp
    validateParameters
    paramsSummaryLog
} from 'plugin/nf-schema'

// Function definitions
def startupMessage() {
    log.info pipelineHeader()
    log.info "~~~ freyr: Metabarcoding analysis for biosecurity and biosurveillance ~~~"
    log.info " "
}

def pipelineHeader(){
    return """
    
    :::::::::: :::::::::  :::::::::: :::   ::: :::::::::  
    :+:        :+:    :+: :+:        :+:   :+: :+:    :+: 
    +:+        +:+    +:+ +:+         +:+ +:+  +:+    +:+ 
    :#::+::#   +#++:++#:  +#++:++#     +#++:   +#++:++#:  
    +#+        +#+    +#+ +#+           +#+    +#+    +#+ 
    #+#        #+#    #+# #+#           #+#    #+#    #+# 
    ###        ###    ### ##########    ###    ###    ### 
    
    """.stripIndent()
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RUN MAIN WORKFLOW
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

workflow {

    startupMessage()

    // Print help message, supply typical command line usage for the pipeline
    if (params.help) {
        def help_message = paramsHelp() as String
        log.info help_message
        exit 0, ''
    }

    // validate input params
    validateParameters()
    
    // Print summary of supplied parameters (that differ from defaults)
    log.info(
        paramsSummaryLog() as String
    )

    workflow.onComplete = {
        if (workflow.success) {
            log.info "[${workflow.complete}] >> Pipeline finished SUCCESSFULLY after ${workflow.duration}"
        } else {
            log.info "[${workflow.complete}] >> Pipeline finished with ERRORS after ${workflow.duration}"
        }
        /*
        TODO: use other metadata (https://www.nextflow.io/docs/latest/metadata.html) to display at the end of a run.
        */
    }

    // make it clear that samples are being subsampled
    if (params.subsample) {
        log.info "***"
        log.info "NOTE: Input samples are being pseudorandomly subsampled to $params.subsample per primer x read group combination (--subsample = $params.subsample)"
        log.info "***"
    }

    if (params.downsample_reads) {
        log.info "***"
        log.info "NOTE: Input samples are being pseudorandomly downsampled to $params.downsample_reads reads (--downsample_reads = $params.downsample_reads)"
        log.info "***"
    }

    // Run freyr workflow
    FREYR()
}
