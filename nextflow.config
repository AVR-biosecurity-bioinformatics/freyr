/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    freyr Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

validation {
    // run will fail if unrecognised parameters are given, not just give a warning
    logging {
        unrecognisedParams = 'error'
        unrecognisedHeaders = 'error'
    }              
    help {
        enabled = true
        command = 'nextflow run AVR-biosecurity-bioinformatics/freyr'
    }
}
}

profiles {
    debug {
        params.rdata           = true
        params.debug_mode      = true
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        charliecloud.enabled   = false
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false        
        shifter.enabled        = false
        singularity.enabled    = false
        wave {
            enabled = true
            strategy = 'conda'
        }
    }
    //// this profile is not enabled because charliecloud does not seem to work 
    // charliecloud {
    //     apptainer.enabled      = false
    //     charliecloud.enabled   = true
    //     conda.enabled          = false
    //     docker.enabled         = false
    //     podman.enabled         = false        
    //     shifter.enabled        = false
    //     singularity.enabled    = false
    // }
    docker {
        apptainer.enabled      = false
        charliecloud.enabled   = false
        conda.enabled          = false
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        podman.enabled         = false        
        shifter.enabled        = false
        singularity.enabled    = false
        wave {
            enabled = true
            strategy = 'conda'
        }
    }
    podman {
        apptainer.enabled      = false
        charliecloud.enabled   = false
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = true        
        shifter.enabled        = false
        singularity.enabled    = false
        wave {
            enabled = true
            strategy = 'conda'
        }
    }
    shifter {
        apptainer.enabled      = false
        charliecloud.enabled   = false
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false        
        shifter.enabled        = true
        singularity.enabled    = false
        wave {
            enabled = true
            strategy = 'conda'
        }
    }
    singularity {
        apptainer.enabled      = false
        charliecloud.enabled   = false
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false        
        shifter.enabled        = false
        singularity.enabled    = true
        singularity.autoMounts = true
        wave {
            enabled = true
            strategy = 'conda'
        }
    }
    basc_slurm {
         process {
            executor = 'slurm'
            queue = {task.time <= 6.h ? 'shortrun' : 'batch'}
            module = 'Miniconda3/24.7.1-0'
            clusterOptions = '--account ngdsi --ntasks=1'
            resourceLimits = [
                cpus:   48,
                memory: 512.GB,
                time:   168.h
            ]
        }
        executor {
            queueSize       = 1000
            pollInterval    = '10 sec' as Duration
            submitRateLimit = '10 sec'
        }

        conda {
            enabled  = true
            useMamba = false
        }

        apptainer.enabled   = false
        charliecloud.enabled = false
        docker.enabled      = false
        podman.enabled      = false
        shifter.enabled     = false
        singularity.enabled = false
        wave.enabled        = false  // BASC uses plain conda environments
    }
    test { /// this profile should always be specified last to force the minimal resource requirements
        params.samplesheet          = 'assets/test_data/dual/samplesheet.csv'
        params.primer_params        = "assets/test_data/dual/primer_params.csv"
        params.miseq_dir            = "assets/test_data/dual"
        params.max_memory           = '2.GB'
        params.max_time             = '10.m'
        params.max_cpus             = 1
        params.miseq_internal       = true
        params.seq_type             = "illumina"
        params.paired               = true
    }
    quick {
        params.max_time             = '10.m'
    }
    error1_backoff {
        process.errorStrategy       = {
                                        if ( task.exitStatus in ((130..145) || 104) ) {
                                            'retry'
                                        } else if ( task.exitStatus == 1 ) {
                                            sleep(Math.pow(2, task.attempt) * 2 as long); return 'retry'
                                        } else {
                                            'finish'
                                        }
                                    }
    }
}

process {

    errorStrategy = {
        def retryCodes = [
            104,  // connection reset
            125,  // docker/podman
            134,  // SIGABRT
            137,  // SIGKILL (often OOM)
            139,  // SIGSEGV
            140,  // SLURM wall clock
            143,  // SIGTERM
            146,  // File system latency
            127   // File system latency
        ]

        if( task.exitStatus == null )
            return 'retry'
        
        // Default value of $task.exitStatus is set to Integer.MAX_VALUE in the absence of an .exitcode file 
        // this catches "terminated for an unknown reason" 
        // see https://github.com/nextflow-io/nextflow/issues/2847#issuecomment-2144844183
        if( task.exitStatus == Integer.MAX_VALUE )
            return 'retry'

        if( task.exitStatus in retryCodes )
            return 'retry'

        return 'terminate'
    }


    maxRetries    = 3
    maxErrors     = -1
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    // Environment labels
    withLabel: env_r_core {
        conda = "${projectDir}/envs/r_core.yml"
    }

    withLabel: env_r_dada2 {
        conda = "${projectDir}/envs/r_dada2.yml"
    }

    withLabel: env_r_phyloseq {
        conda = "${projectDir}/envs/r_phyloseq.yml"
    }

    withLabel: env_r_phmm {
        conda = "${projectDir}/envs/r_phmm.yml"
    }
    
    withLabel: env_blast {
        conda = "${projectDir}/envs/blast.yml"
    }

    withLabel: env_cutadapt {
        conda = "${projectDir}/envs/cutadapt.yml"
    }

    withLabel: env_fastqc {
        conda = "${projectDir}/envs/fastqc.yml"
    }

    withLabel: env_seqtk {
        conda = "${projectDir}/envs/seqtk.yml"
    }

    withLabel: env_nanoplot {
        conda = "${projectDir}/envs/nanoplot.yml"
    }

    // Process-specific resources
    withName: TAX_IDTAXA {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    // Resource labels
    withLabel: very_small {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    withLabel: small {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 60.m * task.attempt }
    }

    withLabel: medium {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: high {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: very_high {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: long {
        time = { 4.h * task.attempt }
    }

    withLabel: phyloseq {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}

plugins {
    id 'nf-schema@3.0.0' // create schema to validate sample sheets and pipeline parameters
    id 'nf-wave@1.22.2'  // Wave based provisioning of containers
}

report {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/report.html"
}

trace {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/trace.tsv"
}

dag {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/dag.html"
    verbose             = true
}

timeline {
    enabled             = true
    overwrite           = true
    file                = "output/run_info/timeline.html"
}

